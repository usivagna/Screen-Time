<Page x:Class="ScreenTimeMonitor.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    
    <ScrollViewer>
        <!-- Main content layer with proper Mica layering -->
        <StackPanel Margin="20" Spacing="20" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="24">
            
            <TextBlock Text="Dashboard" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            
            <!-- Quick Stats Cards following card pattern -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Today's Usage Card -->
                <Border Grid.Column="0" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8" 
                        Padding="16" 
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Today's Usage" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14"/>
                        <TextBlock x:Name="TodayUsageText" 
                                   Text="0h 0m" 
                                   FontSize="24" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Active Applications Card -->
                <Border Grid.Column="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8" 
                        Padding="16" 
                        Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Active Applications" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14"/>
                        <TextBlock x:Name="ActiveAppsText" 
                                   Text="0" 
                                   FontSize="24" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Current Session Card -->
                <Border Grid.Column="2" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8" 
                        Padding="16" 
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Current Session" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14"/>
                        <TextBlock x:Name="CurrentSessionText" 
                                   Text="0h 0m" 
                                   FontSize="24" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Real-time monitoring card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Real-time Monitoring" 
                               FontWeight="SemiBold" 
                               FontSize="18"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Currently Active Application:"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="CurrentAppText" 
                                   Text="No application detected" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Active for:"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ActiveTimeText" 
                                   Text="0s" 
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StartMonitoringBtn" Content="Start Monitoring" Click="StartMonitoring_Click"/>
                        <Button x:Name="StopMonitoringBtn" Content="Stop Monitoring" Click="StopMonitoring_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
