<Page x:Class="ScreenTimeMonitor.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    
    <ScrollViewer>
        <!-- Main content layer with proper Mica layering -->
        <StackPanel Margin="20" Spacing="20" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="24">
            
            <TextBlock Text="Settings" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>
            
            <!-- General Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="General Settings" 
                               FontWeight="SemiBold" 
                               FontSize="18"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    
                    <!-- Theme Selection with Acrylic Flyout -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="App Theme"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="Select Theme" HorizontalAlignment="Left">
                            <Button.Flyout>
                                <Flyout>
                                    <!-- Apply Acrylic to the flyout -->
                                    <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop/>
                                    </Flyout.SystemBackdrop>
                                    <StackPanel Spacing="8" MinWidth="150">
                                        <RadioButton Content="Light" IsChecked="True"/>
                                        <RadioButton Content="Dark"/>
                                        <RadioButton Content="Use system setting"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    
                    <!-- Monitoring Settings -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Monitoring"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ToggleSwitch Header="Start monitoring on app launch" IsOn="True"/>
                        <ToggleSwitch Header="Monitor inactive windows" IsOn="False"/>
                    </StackPanel>
                    
                    <!-- Placeholder for future settings -->
                    <TextBlock Text="Additional settings and preferences will be available in future updates." 
                               FontStyle="Italic"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Data Management Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Data Management" 
                               FontWeight="SemiBold" 
                               FontSize="18"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    
                    <StackPanel Spacing="12">
                        <Button Content="Export Data" HorizontalAlignment="Left">
                            <Button.Flyout>
                                <Flyout>
                                    <!-- Apply Acrylic to the flyout -->
                                    <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop/>
                                    </Flyout.SystemBackdrop>
                                    <StackPanel Spacing="8" MinWidth="200">
                                        <TextBlock Text="Export your screen time data" TextWrapping="Wrap"/>
                                        <Button Content="Export to CSV" HorizontalAlignment="Stretch"/>
                                        <Button Content="Export to JSON" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        
                        <Button Content="Clear All Data" HorizontalAlignment="Left">
                            <Button.Flyout>
                                <Flyout>
                                    <!-- Apply Acrylic to the flyout -->
                                    <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop/>
                                    </Flyout.SystemBackdrop>
                                    <StackPanel Spacing="8" MinWidth="200">
                                        <TextBlock Text="⚠️ This will permanently delete all your screen time data" 
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        <Button Content="Confirm Delete" 
                                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

